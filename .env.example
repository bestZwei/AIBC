# ===================================================================
# AIBC 服务端环境变量示例
# 复制为 .env.local 并填入真实值。.env* 已在 .gitignore 中忽略，切勿入库。
# 所有密钥只在服务端（Route Handlers）读取，绝不下发前端。
# ===================================================================

# ---- AI 文本生成供应商 ----
# AI_PROVIDER 选择「协议适配器」，具体供应商由 BASE_URL / KEY / MODEL 决定。见 src/server/providers/ai/index.ts
#   openai-compatible = 任何 OpenAI 兼容端点（POST {base}/chat/completions + Authorization: Bearer）
#   gemini-native     = Google 原生协议（POST {base}/models/{model}:generateContent + x-goog-api-key）
AI_PROVIDER=openai-compatible
# 基础地址：openai-compatible 拼接 /chat/completions；gemini-native 拼接 /models/{model}:generateContent。
# 下例为 Google AI Studio 的 OpenAI 兼容端点（已验证可用）；两种适配器都可共用它，
# gemini-native 会自动去掉末尾的 /openai，所以切换供应商只需改 AI_PROVIDER。
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# 你的密钥（旧的泄露 Key 已作废，请换成自己的；切勿入库）
AI_API_KEY=replace-with-your-ai-key
# 优先用小模型 + 滚动别名（避免具体版本下线，如 gemini-2.0-flash 已 404）
AI_MODEL=gemini-flash-lite-latest
AI_MAX_TOKENS=1000
AI_TEMPERATURE=0.7

# ---- TTS 语音合成供应商 ----
# 适配器 id，见 src/server/providers/tts/index.ts（内置 "edge-tts"，OpenAI 无关）
TTS_PROVIDER=edge-tts
# 基础地址，适配器会自动拼接 /tts 与 /voices（GET，参数 t/v/r/p）。
# 下例为 LibreTTS 的 Edge-TTS 接口（已验证可用）；亦可换任意 Edge-TTS 兼容 HTTP 服务。
TTS_BASE_URL=https://libretts.is-an.org/api
TTS_DEFAULT_VOICE=zh-CN-XiaoxiaoNeural

# ---- 代理防护 ----
# 每个 IP 每分钟允许的 /api/segment 请求数（内存令牌桶，单实例）
API_RATE_LIMIT_PER_MIN=30
