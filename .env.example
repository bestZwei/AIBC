# ===================================================================
# AIBC 服务端环境变量示例
# 复制为 .env.local 并填入真实值。.env* 已在 .gitignore 中忽略，切勿入库。
# 所有密钥只在服务端（Route Handlers）读取，绝不下发前端。
# ===================================================================

# ---- AI 文本生成供应商 ----
# 适配器 id，见 src/server/providers/ai/index.ts（当前内置 "gemini-balance"，OpenAI 兼容）
AI_PROVIDER=gemini-balance
# 基础地址，适配器会拼接 /chat/completions
AI_BASE_URL=https://gemini-balance.neko.is-cool.dev/v1
# 你的密钥（旧的泄露 Key 已作废，请换成自己的）
AI_API_KEY=replace-with-your-ai-key
AI_MODEL=gemini-2.0-flash
AI_MAX_TOKENS=1000
AI_TEMPERATURE=0.7

# ---- TTS 语音合成供应商 ----
# 适配器 id，见 src/server/providers/tts/index.ts（当前内置 "edge-tts"）
TTS_PROVIDER=edge-tts
# 基础地址，适配器会拼接 /tts 与 /voices
TTS_BASE_URL=https://tts.ciallo.de/api
TTS_DEFAULT_VOICE=zh-CN-XiaoxiaoNeural

# ---- 代理防护 ----
# 每个 IP 每分钟允许的 /api/segment 请求数（内存令牌桶，单实例）
API_RATE_LIMIT_PER_MIN=30
